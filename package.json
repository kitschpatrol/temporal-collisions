		"@types/lodash": "^4.17.24",
		"@types/node": "~24.13.3",
		"shx": "^0.4.0",
		"typescript": "~6.0.3",
		"vitest": "^4.1.10"
	},
	"packageManager": "pnpm@11.5.0",
	"engines": {
		"node": ">=24.16.0"
	}
