{
	"name": "temporal-collisions",
	"version": "1.0.2",
	"private": true,
	"description": "See photos from identical instants in time.",
	"keywords": [
		"itp",
		"simultaneity",
		"flickr"
	],
	"homepage": "https://frontiernerds.com/temporal-collisions",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/temporal-collisions.git"
	},
	"license": "UNLICENSED",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"type": "module",
	"scripts": {
		"clean": "shx rm -f pnpm-lock.yaml && shx mv .env temp && git clean -fdX && shx mv temp .env",
