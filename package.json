		"init": "op inject -i .template.env -o .env",
		"lint": "ksc lint",
		"test": "vitest run"
	},
	"dependencies": {
		"@netlify/functions": "^5.3.0",
		"dotenv": "^17.4.2",
		"flickr-sdk": "^7.1.0"
	},
