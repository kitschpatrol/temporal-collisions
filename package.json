{
	"name": "temporal-collisions",
	"version": "1.0.3",
	"private": true,
	"description": "See photos from identical instants in time.",
	"keywords": [
		"itp",
		"simultaneity",
		"flickr"
	],
	"homepage": "https://frontiernerds.com/temporal-collisions",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/temporal-collisions.git"
	},
	"license": "CC-BY-NC-SA-4.0",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsdown --tsconfig tsconfig.build.json --platform neutral --dts",
		"clean": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"deploy": "wrangler deploy --secrets-file .env",
		"dev": "wrangler dev",
		"fix": "ksc fix",
		"init": "op inject -i .template.env -o .env",
		"lint": "ksc lint",
		"release": "bumpp --commit 'Release: %s'",
		"test": "vitest run"
	},
	"dependencies": {
		"flickr-sdk": "^7.1.0"
	},
	"devDependencies": {
		"@kitschpatrol/dict-en-wiktionary": "^1.5.0",
		"@kitschpatrol/shared-config": "^8.5.0",
		"@types/lodash": "^4.17.24",
		"@types/node": "~24.13.3",
		"bumpp": "^12.0.0",
		"shx": "^0.4.0",
		"tsdown": "^0.22.14",
		"typescript": "~6.0.3",
		"vitest": "^4.1.10",
		"wrangler": "^4.114.0"
	},
	"packageManager": "pnpm@11.5.0",
	"engines": {
		"node": ">=24.16.0"
	}
}
